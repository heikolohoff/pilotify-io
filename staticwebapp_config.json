{
  "routes": [
    {
      "route": "/impressum",
      "rewrite": "/impressum.html"
    },
    {
      "route": "/datenschutz",
      "rewrite": "/datenschutz.html"
    },
    {
      "route": "/agb",
      "rewrite": "/agb.html"
    },
    {
      "route": "/copilot-ready",
      "rewrite": "/copilot-ready.html"
    },
    {
      "route": "/jobs",
      "rewrite": "/jobs.html"
    },
    {
      "route": "/en/jobs",
      "rewrite": "/en/jobs.html"
    },
    {
      "route": "/en",
      "rewrite": "/en/index.html"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/images/*",
      "/assets/*",
      "/*.css",
      "/*.js",
      "/*.png",
      "/*.jpg",
      "/*.jpeg",
      "/*.svg",
      "/*.webp",
      "/*.ico",
      "/*.xml",
      "/*.txt"
    ]
  }
}